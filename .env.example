# ================================================================
# MILCO FIS settings. Normally you only change DB_PASSWORD.
# ================================================================

# PostgreSQL connection (the server you manage in pgAdmin 4)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# The password you chose for the "postgres" user when installing PostgreSQL:
DB_PASSWORD=
DB_NAME=milco_fis

# ONLINE HOSTING (Render, Neon, Supabase, Railway): instead of the five DB_ settings above,
# paste the full connection string your database host gives you. When set, DB_HOST..DB_NAME are ignored.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Web address port: http://localhost:4000
PORT=4000

# true = fill an empty database with sample FY2026 trading (Jan to Nov 2026)
# false = start FY2026 with no transactions (opening balances from FY2025 only)
SAMPLE_TRANSACTIONS=true

# Show the demo usernames on the sign-in page. Set to false once everyone has a real password.
SHOW_DEMO_ACCOUNTS=true

# ---------------- Mobile money ----------------
# The numbers customers send money to. Shown on the till and on receipts,
# and used by Finance when checking transaction IDs against the statements.
MPESA_MERCHANT_NUMBER=58847088
MPESA_ACCOUNT_NAME=MILCO
ECOCASH_MERCHANT_NUMBER=62178072
ECOCASH_ACCOUNT_NAME=MILCO

# Optional: Vodacom Lesotho M-Pesa Open API (automatic payment prompt on the customer's phone).
# Needs a business account with Vodacom and the keys from the M-Pesa developer portal.
# Leave MPESA_API_ENABLED=false to use the transaction-ID method (works with any M-Pesa number).
MPESA_API_ENABLED=false
MPESA_API_ENV=sandbox
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_ORIGIN=*
