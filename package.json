{
  "name": "milco-fis",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "MILCO Financial Information System v5: four departments with separation of duties, approvals, POS with M-Pesa and EcoCash, double-entry ledger, Finance and Management reporting, HR and payroll, on PostgreSQL.",
  "scripts": {
    "start": "vite build && node server/index.js",
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.js",
    "build": "vite build",
    "db:reset": "node scripts/reset-db.mjs",
    "db:seed-sql": "node scripts/make-seed-sql.mjs",
    "test": "node --test tests/finance.test.mjs"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
